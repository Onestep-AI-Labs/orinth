{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onestep AI Platform",
  "version": "0.1.0",
  "identifier": "ai.onestep.platform",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Onestep AI Platform",
    "longDescription": "Dataset, training, and inference platform for image and NLP models.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["resources/**/*"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
